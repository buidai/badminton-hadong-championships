// Firestore rules for the badminton tournament app.
// Dev mode: allow all reads/writes. The app uses a frontend-only hardcoded admin
// (localStorage flag), so it has no Firebase Auth — writes would be blocked by
// the stricter rules. TODO (step 6): add Firebase Auth for admin and tighten these.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
